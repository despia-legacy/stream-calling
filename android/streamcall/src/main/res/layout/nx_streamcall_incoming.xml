<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen incoming call over the lock screen: Material 3 components under the activity's
     Theme.Material3.DayNight.NoActionBar, so it follows the system light and dark setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/nx_streamcall_caller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nx_streamcall_decline"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="@string/nx_streamcall_decline"
            app:icon="@android:drawable/ic_menu_close_clear_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nx_streamcall_answer"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nx_streamcall_answer"
            app:icon="@android:drawable/ic_menu_call" />
    </LinearLayout>
</LinearLayout>
